// Arrays of heap cells. A `Ref` cannot be constructed in Raven, so the addressing of
// an array's cells is axiomatized, and so is the allocation of an array.
module Array[E: Library.Type] : Library.Type {
  free rep type T

  // The cell holding the entry at index i of array a.
  free func loc(a: T, i: Int) returns (r: Ref)
  free func length(a: T) returns (l: Int)

  // Left inverses of loc, so that distinct arrays or indices have distinct cells.
  free func first(r: Ref) returns (a: T)
  free func second(r: Ref) returns (i: Int)

  free auto axiom all_diff()
    ensures forall a: T, i: Int :: {loc(a, i)} first(loc(a, i)) == a && second(loc(a, i)) == i

  free auto axiom len_nonneg()
    ensures forall a: T :: {length(a)} length(a) >= 0

  field value: E

  // The entries of a are given by m, which is E.default outside a's bounds.
  pred arr(a: T; m: Map[Int, E]) {
    (forall j: Int :: {m[j]} 0 <= j < length(a) ==> own(loc(a, j).value, m[j], 1.0))
    && (forall j: Int :: {m[j]} (0 > j || j >= length(a)) ==> m[j] == E.default)
  }

  // A new array of length len, all of whose entries are d.
  free proc alloc(len: Int, d: E) returns (a: T)
    requires 0 <= len
    ensures length(a) == len && arr(a, {| i: Int :: 0 <= i < len ? d : E.default |})
}
