// Hardware-provided atomic primitives, as ordinary Raven procedures.
//
// Nothing here is privileged: a user needing a primitive this file does not
// provide writes it the same way, with nothing to change in the verifier.
//
// Each primitive is an `atomic proc`: its body -- a read plus a conditional write,
// which the hardware collapses into one instruction -- is one physical step, so a
// caller may open an invariant or atomic update around the call. The contract is
// an ordinary one, describing that step. The field each primitive operates on
// arrives through the module parameter, and a caller never names an instance: the
// parameter is solved from the field its location argument names.
//
// Import what you need; nothing here is in scope by default.
//
//   import Library.Atomics._      // cas, cmpxchg, xchg -- any word-sized field
//   import Library.IntAtomics._   // those three plus faa -- Int fields only
//
// IntAtomics inherits the other three, but at its own parameter: `IntAtomics.cas`
// works on an Int field only. So if a scope needs `faa` *and* one of the other
// three on a field that is not an Int, it wants both imports -- and that is fine.
// The only thing to know is that an Int field used with both will then get two
// adapter modules and two instantiations rather than one, since its `cas` resolves
// through Atomics while its `faa` goes through IntAtomics. Harmless, and avoided by
// importing IntAtomics alone when every field in scope is an Int.

// A type with a machine-word representation. A marker: it declares nothing beyond
// the representation type, and the substance is a structural check the front end
// runs on whatever type an implementation supplies -- Int, Bool, Ref, or a small
// sum of those. It deliberately says nothing about value ranges. Raven's Int is
// the mathematical integers, so a bound such as `0 <= x < 2^62` would be
// unsatisfiable for an Int field and would make the interface unimplementable.
interface WordSized : Library.Type {
  rep type T
}

// A single field of word-sized type, supplied by the client. `f` is inherited by
// implementors rather than redeclared, which is what lets the modules below be
// verified once against an abstract field rather than per instantiation.
interface AtomicField {
  module E : WordSized
  field f : E
}

// A field whose values are machine integers, for the one primitive that needs
// arithmetic.
interface IntField : AtomicField {
  module E : WordSized { rep type T = Int }
}

// Everything that needs only equality on the field's type.
module Atomics[A: AtomicField] {

  // Compare-and-swap: write `new_val` if the field holds `old_val`, and report
  // whether it did.
  atomic proc cas(x.A.f, old_val: A.E, new_val: A.E, implicit ghost v: A.E, implicit ghost q: Real)
    returns (b: Bool)
    requires own(x.A.f, v, q) && (v == old_val ? q == 1.0 : q > 0)
    ensures own(x.A.f, v == old_val ? new_val : v, q)
          && b == (v == old_val)
  {
    val cur: A.E := x.A.f;
    if (cur == old_val) {
      x.A.f := new_val;
      b := true;
    } else {
      b := false;
    }
  }

  // As `cas`, but also reports the value it found. That extra value is the only
  // difference between the two.
  atomic proc cmpxchg(x.A.f, old_val: A.E, new_val: A.E, implicit ghost v: A.E, implicit ghost q: Real)
    returns (res: (A.E, Bool))
    requires own(x.A.f, v, q) && (v == old_val ? q == 1.0 : q > 0)
    ensures own(x.A.f, v == old_val ? new_val : v, q)
          && res == (v, v == old_val)
  {
    val cur: A.E := x.A.f;
    if (cur == old_val) {
      x.A.f := new_val;
      res := (cur, true);
    } else {
      res := (cur, false);
    }
  }

  // Unconditional swap, returning the value replaced.
  atomic proc xchg(x.A.f, new_val: A.E, implicit ghost v: A.E)
    returns (old_val: A.E)
    requires own(x.A.f, v, 1.0)
    ensures own(x.A.f, new_val, 1.0) && old_val == v
  {
    old_val := x.A.f;
    x.A.f := new_val;
  }
}

// Adds the one primitive that needs arithmetic. Inheriting from `Atomics[A]` means
// an Int-field client imports this module alone and gets all four, and the spec
// below writes plain `v + n` rather than an encoding, because the parameter is
// strong enough to say so.
module IntAtomics[A: IntField] : Atomics[A] {

  // Fetch-and-add, returning the value before the addition.
  atomic proc faa(x.A.f, n: Int, implicit ghost v: Int)
    returns (old_val: Int)
    requires own(x.A.f, v, 1.0)
    ensures own(x.A.f, v + n, 1.0) && old_val == v
  {
    old_val := x.A.f;
    x.A.f := old_val + n;
  }
}
