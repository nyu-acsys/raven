include "queue_lock.rav"

import Library.Atomics._

// Each acquisition allocates a fresh node; released guards cannot be reused.
module MCSLock[R: LockResource] :> QueueLock[R] {
  rep type T = Ref
  type Guard = Ref
  import R.resource

  field lk: Ref

  field lock_wait: Bool
  field next: Ref

  module Ref_Bool_Type : Library.Type {
    rep type T = (Ref, Bool)
  }

  module Frac_Ref_Bool = Library.Frac[Ref_Bool_Type]
  import Frac_Ref_Bool.frac_chunk

  ghost field token: Frac_Ref_Bool

  inv signal_loc_inv(l: Ref, v: Ref, n: Ref, r: R) within is_lock(l, r) {
    exists b_choice: Bool ::
      b_choice ? own(n.token, frac_chunk((v, false), 1.0)) :

      (exists b: Bool ::
        own(v.lock_wait, b, 1.0) &&
        (b == true ?
          true :

          resource(r) &&
          own(n.token, frac_chunk((v, false), 0.5))
        )
      )
  }

  inv waiting_loc_inv(l: Ref, n: Ref, r: R) within is_lock(l, r) {
    exists b_choice: Bool ::
      b_choice ? own(n.token, frac_chunk((n, true), 1.0)) :

      (exists n': Ref :: own(n.next, n', 0.5) &&
        (n' != null ==>

          (own(n.next, n', 0.5) &&
          own(n.token, frac_chunk((n, true), 0.5)) &&
          (exists ghost_l: Ref :: own(ghost_l.token, frac_chunk((n', false), 0.5)) &&
          signal_loc_inv(l, n', ghost_l, r)))
        )
      )
  }

  inv is_lock(l: Ref, r: R) {
    exists tl: Ref :: own(l.lk, tl) &&
    (tl == null ?
      resource(r) :

      (own(tl.next, null, 0.5) &&
      own(tl.token, frac_chunk((tl, true), 0.5)) &&
      waiting_loc_inv(l, tl, r))
    )
  }

  pred free_node(node: Ref) {
    exists b: Bool, n: Ref :: own(node.lock_wait, b) && own(node.next, n)
  }

  pred held(l: Ref, node: Ref, r: R) {
    (exists b: Bool :: own(node.lock_wait, b, 1.0)) &&
    waiting_loc_inv(l, node, r) &&
    own(node.token, frac_chunk((node, true), 0.5))
  }

  proc create(r: R) returns (l: Ref) {
    l := new(lk: null);
    fold is_lock(l, r);
  }

  proc new_node() returns (node: Ref)
    ensures free_node(node) && own(node.token, frac_chunk((node, true), 1.0))
  {
    node := new(lock_wait: true, next: null, token: frac_chunk((null, true), 1.0));
    fold free_node(node);
    fpu(node.token, frac_chunk((node, true), 1.0));
  }

  proc wait_on(l: Ref, node: Ref, implicit ghost prd: Ref, implicit ghost r: R)
    requires signal_loc_inv(l, node, prd, r) && own(prd.token, frac_chunk((node, false), 0.5))
    ensures resource(r) && own(node.lock_wait, false, 1.0)
    opens is_lock(l, r)
  {
    unfold signal_loc_inv(l, node, prd, r);

    val lk_wait: Bool := node.lock_wait;

    if (lk_wait) {
      fold signal_loc_inv(l, node, prd, r)[b_choice := false];
      wait_on(l, node, prd, r);
    } else {
      fold signal_loc_inv(l, node, prd, r)[b_choice := true];
    }
  }

  proc acquire_node(l: Ref, node: Ref, implicit ghost r: R)
    requires is_lock(l, r) && free_node(node) && own(node.token, frac_chunk((node, true), 1.0))
    ensures held(l, node, r) && resource(r)
    opens is_lock(l, r)
  {
    unfold free_node(node);
    node.next := null;
    var prd: Ref;

    unfold is_lock(l, r);
    prd := xchg(l.lk, node);

    if (prd == null) {
      fold waiting_loc_inv(l, node, r)[b_choice := false, ghost_l := null];
      fold is_lock(l, r);
      fold held(l, node, r);

    } else {
      fold waiting_loc_inv(l, node, r)[b_choice := false, ghost_l := null];
      fold is_lock(l, r);

      node.lock_wait := true;

      unfold waiting_loc_inv(l, prd, r);

      prd.next := node;

      ghost var ghost_l := new(token: frac_chunk((node, false), 1.0));
      fold signal_loc_inv(l, node, ghost_l, r)[b_choice := false];
      fold waiting_loc_inv(l, prd, r)[b_choice := false, ghost_l := ghost_l];
      wait_on(l, node, ghost_l, r);
      fold held(l, node, r);
    }
  }

  proc wait_for_succ(l: Ref, node: Ref, implicit ghost r: R, implicit ghost ghost_l: Ref)
    requires waiting_loc_inv(l, node, r)
    requires own(node.token, frac_chunk((node, true), 0.5))
    ensures exists l2: Ref :: own(node.next, l2) && l2 != null &&
      own(ghost_l.token, frac_chunk((l2, false), 0.5)) && signal_loc_inv(l, l2, ghost_l, r)
    opens is_lock(l, r)
  {
    unfold waiting_loc_inv(l, node, r)[ghost_l := ghost_l];
    var node_next := node.next;

    if (node_next == null) {
      fold waiting_loc_inv(l, node, r)[b_choice := false, ghost_l := null];
      wait_for_succ(l, node, r, ghost_l);
    } else {
      fold waiting_loc_inv(l, node, r)[b_choice := true, ghost_l := null];
    }
  }

  proc release_node(l: Ref, node: Ref, implicit ghost r: R)
    requires is_lock(l, r) && held(l, node, r) && resource(r)
    ensures free_node(node)
    opens is_lock(l, r)
  {
    unfold held(l, node, r);
    ghost var ghost_l: Ref;
    unfold waiting_loc_inv(l, node, r)[ghost_l := ghost_l];

    var node_next: Ref := node.next;

    if (node_next == null) {
      fold waiting_loc_inv(l, node, r)[b_choice := false, ghost_l := null];
      unfold is_lock(l, r);
      var b: Bool := cas(l.lk, node, null);

      if (b) {
        fold is_lock(l, r);
        unfold waiting_loc_inv(l, node, r);
        fold waiting_loc_inv(l, node, r)[b_choice := true, ghost_l := null];
        fold free_node(node);

        return;
      } else {
        fold is_lock(l, r);

        wait_for_succ(l, node, r, ghost_l);
      }
    } else {
      fold waiting_loc_inv(l, node, r)[b_choice := true, ghost_l := null];
    }

    node_next := node.next;

    if (node_next == null) {
      assert false;
    } else {
      unfold signal_loc_inv(l, node_next, ghost_l, r);
      node_next.lock_wait := false;
      fold signal_loc_inv(l, node_next, ghost_l, r)[b_choice := false];
      fold free_node(node);
    }
  }

  proc acquire(l: Ref, implicit ghost r: R) returns (guard: Ref) {
    guard := new_node();
    acquire_node(l, guard, r);
  }

  proc release(l: Ref, guard: Ref, implicit ghost r: R) {
    release_node(l, guard, r);
  }
}
