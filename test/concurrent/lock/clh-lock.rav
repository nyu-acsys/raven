include "queue_lock.rav"

import Library.Atomics._

// Each acquisition allocates a fresh private node for its guard.
module CLHLock[R: LockResource] :> QueueLock[R] {
  rep type T = Ref
  type Guard = Ref

  field locked: Bool
  field loc: Ref
  field predecessor: Ref
  field tail: Ref

  ghost field agr: ()

  inv queued_loc(l: Ref, q: Ref, r: R) parent is_lock(l, r) {
    exists detached: Bool, b: Bool ::
      (detached ? own(q, agr, (), 1.0) :
        own(q, locked, b, 0.5) &&
        (!b ==> R.resource(r) && own(q, agr, (), 0.5) && own(q, locked, b, 0.5)))
  }

  inv is_lock(l: Ref, r: R) {
    exists q: Ref ::
      own(l, tail, q, 1.0) &&
      own(q, agr, (), 0.5) &&
      queued_loc(l, q, r)
  }

  pred held(l: Ref, guard: Ref, r: R) {
    exists ln: Ref, pn: Ref ::
      own(guard, loc, ln, 1.0) &&
      queued_loc(l, ln, r) && own(ln, agr, (), 0.5) &&
      own(ln, locked, true, 0.5) &&
      own(guard, predecessor, pn, 1.0) &&
      own(pn, locked, false, 1.0) &&
      queued_loc(l, pn, r)
  }

  inline pred free_node(l: Ref, node: Ref, r: R) {
    exists ln: Ref, pn: Ref ::
      own(node, loc, ln, 1.0) &&
      own(ln, locked, false, 1.0) &&
      own(node, predecessor, pn, 1.0) &&
      queued_loc(l, ln, r)
  }

  proc create_node(l: Ref, ghost r: R) returns (node: Ref)
    ensures free_node(l, node, r)
    opens {}
  {
    var newloc := new(locked: false, agr: ());
    node := new(loc: newloc, predecessor: null);
    fold queued_loc(l, newloc, r)[detached := true];
  }

  proc create(r: R) returns (l: Ref)
    requires R.resource(r)
    ensures is_lock(l, r)
    opens {}
  {
    var q := new(locked: false, agr: ());
    l := new(tail: q);
    fold queued_loc(l, q, r)[detached := false];
    fold is_lock(l, r);
  }

  proc wait_on(l: Ref, pn: Ref, ln: Ref, node: Ref, ghost r: R)
    requires is_lock(l, r) && queued_loc(l, ln, r) &&
      own(node, loc, ln, 1.0) &&
      own(node, predecessor, pn, 1.0) &&
      own(ln, agr, (), 0.5) &&
      own(ln, locked, true, 0.5) &&
      queued_loc(l, pn, r) && own(pn, agr, (), 0.5)
    ensures held(l, node, r) && R.resource(r)
    opens is_lock(l, r)
  {
    ghost var branch: Bool;
    unfold queued_loc(l, pn, r)[branch := detached];
    var b := pn.locked;
    fold queued_loc(l, pn, r)[b := b, detached := !b || branch];

    if (b) {
      wait_on(l, pn, ln, node, r);
    } else {
      fold held(l, node, r);
    }
  }

  proc acquire(l: Ref, implicit ghost r: R) returns (guard: Ref)
    requires is_lock(l, r)
    ensures is_lock(l, r) && held(l, guard, r) && R.resource(r)
    opens is_lock(l, r)
  {
    guard := create_node(l, r);
    var ln := guard.loc;
    ln.locked := true;

    unfold is_lock(l, r);
    unfold queued_loc(l, ln, r);
    var pn := xchg(l.tail, ln);
    fold queued_loc(l, ln, r)[detached := false];
    fold is_lock(l, r);

    guard.predecessor := pn;
    wait_on(l, pn, ln, guard, r);
  }

  proc release(l: Ref, guard: Ref, implicit ghost r: R)
    requires is_lock(l, r) && held(l, guard, r) && R.resource(r)
    ensures is_lock(l, r)
    opens is_lock(l, r)
  {
    unfold held(l, guard, r);
    var ln := guard.loc;
    unfold queued_loc(l, ln, r);
    ln.locked := false;
    fold queued_loc(l, ln, r)[detached := false];

    var pn := guard.predecessor;
    guard.loc := pn;
  }
}
