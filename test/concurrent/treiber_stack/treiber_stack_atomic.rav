import Library.Type
import Library.Option

import Library.Atomics._

module Stack[T: Type] {

  module ListT = Library.List[T]
  import ListT._

  field top: Ref
  field next: Ref
  field value: T


  pred list(x: Ref; xs: ListT.T) {
    x == null ?
      xs == nil :
      (xs != nil && (exists tl0: Ref, q: Real ::  q > 0.0 && (own(x.value, xs.hd, q) && own(x.next, tl0, q) && list(tl0, xs.tl))))
  }

  pred stack(s: Ref; xs: ListT.T) {
    exists x: Ref :: own(s.top, x, 1.0) && list(x, xs)
  }

  proc push(s: Ref, x: T, implicit ghost xs: ListT.T)
    atomic requires stack(s, xs)
    atomic ensures stack(s, x :: xs)
  {
    ghost val phi := bindAU();
    ghost val xs0: ListT.T := openAU(phi);

    unfold stack(s);
    var topv := s.top;
    fold stack(s, xs0);

    abortAU(phi);

    var s0 : Ref;
    s0 := new(value: x, next: topv);

    ghost val xs1: ListT.T := openAU(phi);

    ghost val top1: Ref;
    unfold stack(s)[top1 := x];

    var res := cas(s.top, topv, s0);

    if (!res) {
      fold stack(s, xs1);
      abortAU(phi);
      ghost val xs2: ListT.T := openAU(phi);
      push(s, x);
      commitAU(phi, ());
    } else {
      fold list(s0, x :: xs1)[q := 1.0];
      fold stack(s, x :: xs1);
      commitAU(phi, ());
    }
  }

  proc pop(s: Ref, implicit ghost xs: ListT.T)
    returns (result: Option[T])
    atomic requires stack(s, xs)
    atomic ensures
      xs == nil ?
        (stack(s, xs) && result == Option.none) :
        (stack(s, xs.tl) && result == Option.some(xs.hd))
  {
    ghost val phi := bindAU();
    ghost val xs0: ListT.T := openAU(phi);

    unfold stack(s);

    var topv := s.top;

    ghost val q: Real; ghost val tl0: Ref;

    if (topv == null) {
      unfold list(topv)[q := q];
      fold list(topv, xs0)[q := q];
      fold stack(s, xs0);
      commitAU(phi, Option.none);
    } else {
      unfold list(topv)[tl0 := tl0, q := q];
      fold list(topv, xs0)[q := q/2.0];
      fold stack(s, xs0);
      abortAU(phi);
    }

    if (topv == null) {
      return Option.none;
    }

    val top_next := topv.next;
    val top_value := topv.value;

    ghost val xs1: ListT.T := openAU(phi);
    ghost val top1: Ref;
    unfold stack(s)[top1 := x];

    var res := cas(s.top, topv, top_next);

    if (res) {
      unfold list(top1);
      fold stack(s, xs1.tl);
      commitAU(phi, Option.some(top_value));
      return Option.some(top_value);
    } else {
      fold stack(s, xs1);
      abortAU(phi);
      ghost val xs2: ListT.T := openAU(phi);
      val ret := pop(s);
      commitAU(phi, ret);

      return ret;
    }
  }
}
