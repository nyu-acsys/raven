module Dfrac[X: Library.Type] : Library.ResourceAlgebra {
    rep type T = data {
        case dfrac_null
        case dfrac_chunk(chunk_proj1: X, chunk_proj2: Real)
        case dfrac_disc(disc_proj1: X)
        case dfrac_both(both_proj1: X, both_proj2: Real)
        case dfrac_top
    }

    val id: T = dfrac_null

    func valid(n:T) 
        returns (ret:Bool) 
    {
        match n {
            case dfrac_null => true
            case dfrac_chunk(_, q) => q > 0.0 && q <= 1.0
            case dfrac_disc(_) => true
            case dfrac_both(_, q) => q > 0.0 && q < 1.0
            case dfrac_top => false
        }
    }

    func comp(a:T, b:T) returns (ret:T) {
        a == dfrac_null ? b :
        (b == dfrac_null ? a :
        (valid(a) && valid(b) ?
            (a is dfrac_chunk && b is dfrac_chunk && a.chunk_proj1 == b.chunk_proj1 && a.chunk_proj2 + b.chunk_proj2 <= 1.0 ?
                dfrac_chunk(a.chunk_proj1, a.chunk_proj2 + b.chunk_proj2) :
            (a is dfrac_chunk && b is dfrac_disc && a.chunk_proj1 == b.disc_proj1 && a.chunk_proj2 < 1.0 ?
                dfrac_both(a.chunk_proj1, a.chunk_proj2) :
            (a is dfrac_chunk && b is dfrac_both && a.chunk_proj1 == b.both_proj1 && a.chunk_proj2 + b.both_proj2 < 1.0 ?
                dfrac_both(a.chunk_proj1, a.chunk_proj2 + b.both_proj2) :
            (a is dfrac_disc && b is dfrac_chunk && a.disc_proj1 == b.chunk_proj1 && b.chunk_proj2 < 1.0 ?
                dfrac_both(a.disc_proj1, b.chunk_proj2) :
            (a is dfrac_disc && b is dfrac_disc && a.disc_proj1 == b.disc_proj1 ?
                dfrac_disc(a.disc_proj1) :
            (a is dfrac_disc && b is dfrac_both && a.disc_proj1 == b.both_proj1 && b.both_proj2 < 1.0 ?
                dfrac_both(a.disc_proj1, b.both_proj2) :
            (a is dfrac_both && b is dfrac_chunk && a.both_proj1 == b.chunk_proj1 && a.both_proj2 + b.chunk_proj2 < 1.0 ?
                dfrac_both(a.both_proj1, a.both_proj2 + b.chunk_proj2) :
            (a is dfrac_both && b is dfrac_disc && a.both_proj1 == b.disc_proj1 && a.both_proj2 < 1.0 ?
                dfrac_both(a.both_proj1, a.both_proj2) :
            (a is dfrac_both && b is dfrac_both && a.both_proj1 == b.both_proj1 && a.both_proj2 + b.both_proj2 < 1.0 ?
                dfrac_both(a.both_proj1, a.both_proj2 + b.both_proj2) :
                dfrac_top))))))))) :
            dfrac_top)
        )
    }

    func frame(a:T, b:T) returns (ret:T) {
        b == dfrac_null ? a :
        (a is dfrac_chunk && b is dfrac_chunk && valid(a) && valid(b) && a.chunk_proj1 == b.chunk_proj1 && a.chunk_proj2 - b.chunk_proj2 >= 0.0 ?
                (a.chunk_proj2 == b.chunk_proj2 ? dfrac_null : dfrac_chunk(a.chunk_proj1, a.chunk_proj2 - b.chunk_proj2)) :
        (a is dfrac_disc && b is dfrac_disc && valid(a) && valid(b) && a.disc_proj1 == b.disc_proj1 ?
            dfrac_disc(a.disc_proj1) :
        (a is dfrac_both && b is dfrac_chunk && valid(a) && valid(b) && a.both_proj1 == b.chunk_proj1 && a.both_proj2 - b.chunk_proj2 >= 0.0 ?
            (a.both_proj2 == b.chunk_proj2 ? dfrac_disc(a.both_proj1) : dfrac_both(a.both_proj1, a.both_proj2 - b.chunk_proj2)) :
        (a is dfrac_both && b is dfrac_disc && valid(a) && valid(b) && a.both_proj1 == b.disc_proj1 ?
            dfrac_both(a.both_proj1, a.both_proj2) :
        (a is dfrac_both && b is dfrac_both && valid(a) && valid(b) && a.both_proj1 == b.both_proj1 && a.both_proj2 - b.both_proj2 >= 0.0 ?
            (a.both_proj2 == b.both_proj2 ? dfrac_disc(a.both_proj1) : dfrac_both(a.both_proj1, a.both_proj2 - b.both_proj2)) :
            dfrac_top)))))
    }

    func fpuAllowed(a:T, b:T) returns (ret:Bool) {
        (a == dfrac_chunk(a.chunk_proj1, 1.0) && b == dfrac_chunk(b.chunk_proj1, 1.0) ? true :
        (a == dfrac_chunk(a.chunk_proj1, 1.0) && b == dfrac_disc(a.chunk_proj1) ? true :
        false))
    }
}

