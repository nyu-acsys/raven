// Viper's test sequences.vpr. Viper's `==` on sequences compares them entry by entry,
// which is `Seq.equal` here. The assertions Viper expects to fail are in
// failures.t, and Viper's range sequence `[-1..10)` and its checks that an
// index is in bounds have no counterpart in Raven.

proc t1(x: Int, xs: Seq[Int]) {
  var n: Seq[Int] := [||];
  assert Seq.length(n) == 0;
  assert !Seq.equal(n, [|x|]);
  assert Seq.length([|1|]) == 1;
}

proc t2() {
  assert 1 in [|1, 2, 3|];
  assert Seq.equal([|1|] ++ [|2|], [|1, 2|]);

  var a: Seq[Int] := [|0, 1, -11, 22|];
  assert a[2] == -11;

  assert Seq.equal(a[..1], [|0|]);
  assert Seq.equal(a[1..], [|1, -11, 22|]);
  assert Seq.equal(a[1..2], [|1|]);

  assert Seq.equal(a[1 := 22], a[1 := -1][1 := 22]);
  assert Seq.equal(a[1 := 22], [|0, 22, -11, 22|]);
  assert Seq.length(a[1 := 22]) == 4;
  assert a[1 := 22][1] == 22;
  assert a[1 := 22][2] == -11;
}

proc test3() {
  var xs: Seq[Int] := [|0, 1, 2, 3, 4, 5, 6, 7|];
  var bs: Seq[Bool] := [|true, true, false, true|] ++ [|false, true|];

  assert Seq.length(xs[1..][..6]) == Seq.length(bs);
}

proc test4(s: Seq[Int], i: Int, j: Int)
  requires 0 <= i
  requires i <= j
{
  assert Seq.equal(s, s[..i] ++ s[i..]);
  assert Seq.equal(s, s[..i] ++ s[i..j] ++ s[j..]);
  assert Seq.equal((s[..i] ++ s[i..j]) ++ s[j..], s[..i] ++ (s[i..j] ++ s[j..]));
}

proc test5(s: Seq[Int], i: Int, j: Int) {
  assert Seq.equal(s, s[..i] ++ s[i..]);
}

proc test6() {
  assert [|3, 4, 5, 6|][0] == 3;
  assert [|3, 4, 5, 6|][1] == 4;
  assert [|3, 4, 5, 6|][2] == 5;
  assert [|3, 4, 5, 6|][3] == 6;
}
