// `colourings1` of Viper's test sequence_incompletenesses.vpr, which omits the
// assertion `soln[2..] == oldSoln[2..]`. Silicon fails to verify the assertion
// `valid(soln, n, true)` after it, and so does Raven.

// Sequences of "how many reds", "how many blacks", "how many reds", etc.
func valid(s: Seq[Int], lenTiles: Int, isStart: Bool) returns (r: Bool)
{
  Seq.length(s) == 0 ? lenTiles == 0 :
  Seq.length(s) == 1 ?
    lenTiles == s[0] && (isStart ? s[0] == 0 || s[0] >= 3 : s[0] >= 3) :
  (isStart ? s[0] == 0 || s[0] >= 3 : s[0] >= 3) && s[1] > 0 &&
    valid(s[2..], lenTiles - s[1] - s[0], false)
}

proc colourings1() {
  var count: Map[Int, Seq[Seq[Int]]];

  count[0] := [|[||]|];

  count[1] := [|[|0, 1|]|];
  assert valid([||], 0, false);
  assert Seq.equal([|0, 1|][2..], [||]);
  assert forall j: Int :: 0 <= j && j < Seq.length(count[1]) ==>
    Seq.equal(count[1][j], [|0, 1|]) && valid(count[1][j], 1, true);

  count[2] := [|[|0, 2|]|];
  assert Seq.equal([|0, 2|][2..], [||]);
  assert forall j: Int :: 0 <= j && j < Seq.length(count[2]) ==>
    valid(count[2][j], 2, true);

  count[3] := [|[|0, 3|], [|3|]|];
  assert Seq.equal([|0, 3|][2..], [||]);
  assert forall j: Int :: 0 <= j && j < Seq.length(count[3]) ==>
    valid(count[3][j], 3, true);

  var n: Int := 4;
  while (n <= 50)
    invariant 4 <= n && n <= 51
    invariant forall m: Int, j: Int :: 0 <= m && m < n && 0 <= j && j < Seq.length(count[m]) ==>
      valid(count[m][j], m, true)
  {
    count[n] := [||];
    var i: Int := 0;
    while (i < Seq.length(count[n - 1]))
      invariant 4 <= n && n <= 50
      invariant forall m: Int, j: Int :: 0 <= m && m < n && 0 <= j && j < Seq.length(count[m]) ==>
        valid(count[m][j], m, true)
      invariant 0 <= i && i <= Seq.length(count[n - 1])
      invariant Seq.length(count[n]) == i
      invariant forall j: Int :: 0 <= j && j < Seq.length(count[n - 1]) ==>
        valid(count[n - 1][j], n - 1, true)
      invariant forall j: Int :: {count[n][j]} 0 <= j && j < i ==> valid(count[n][j], n, true)
    {
      var oldSoln: Seq[Int] := count[n - 1][i];
      var soln: Seq[Int];
      if (oldSoln[0] == 0) {
        soln := oldSoln[1 := oldSoln[1] + 1];
        assert valid(soln, n, true);
      } else {
        soln := [|0, 1|] ++ oldSoln;
        assert Seq.equal(soln[2..], oldSoln);
        assert valid(oldSoln, n - 1, false);
        assert valid(soln, n, true);
      }
      count[n] := count[n] ++ [|soln|];
      i := i + 1;
    }

    n := n + 1;
  }
}
