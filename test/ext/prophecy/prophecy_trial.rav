import Library._
import Library.List._

proc p() {

  var myProph: Proph[Int, 1];
  var myPred: Int;
  var actual: Int;

  // One-shot prophecies
  myProph, myPred := new Proph[Int, 1];
  assert Proph.proph(myProph, myPred);

  Proph.resolve(myProph, actual);
  assert (myPred == actual);

  var myProph': Proph[Bool];
  var bs: List[Bool];

  // Multi-shot prophecies
  myProph', bs := new Proph[Bool];
  assert Proph.proph(myProph', bs);
  Proph.resolve(myProph', true);

  assert bs.hd == true;
  assert Proph.proph(myProph', bs.tl);
}
