module BoolList = Library.List[Library.BoolType]
module RefList = Library.List[Library.RefType]
module IntList = Library.List[Library.IntType]
module BoolRefList = Library.List[(Bool, Ref)]

type T = BoolList.T
// type R = IntList.T

module BoolOps {
  import BoolList._

  proc p() {
    assert true :: nil == true :: nil;
  }
}

module RefOps {
  import RefList._

  proc p() {
    var z: RefList.T;
    var x: Ref;

    z := x :: nil;
    // len(z);
    z := x :: z;

    assert z == x :: x :: nil;
    assert forall x: RefList.T :: x == nil || true;
    var zz : BoolRefList.T;

    assert len(z) == 2;
  }
}

module IntOps {
  import IntList._

  proc p() {
    var zzz := 1 :: nil;

    var xx := 0 :: 5 :: nil;

    assert len(xx) == 2;
    assert is_in(xx, 0) && is_in(xx, 5);
    assert !is_in(xx, 2);

    assert xx.hd == 0;
    assert xx.hd != 5;
    assert xx.tl.hd == 5;
    assert xx.tl.hd != 0;
  }
}
