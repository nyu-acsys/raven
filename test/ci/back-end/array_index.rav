// Reading, writing and owning array entries by index.
module M {
  module A = Library.Array[Library.IntType]
  import A._

  proc swap(a: A.T, i: Int, j: Int, implicit ghost vi: Int, implicit ghost vj: Int)
    requires 0 <= i < length(a) && 0 <= j < length(a) && i != j
    requires own(a[i], vi) && own(a[j], vj)
    ensures own(a[i], vj) && own(a[j], vi)
  {
    var x := a[i];
    var y: Int := a[j];
    a[i] := y;
    a[j] := x;
  }

  proc fill(a: A.T, x: Int, implicit ghost m: Map[Int, Int])
    requires arr(a, m)
    ensures arr(a, {| i: Int :: 0 <= i && i < length(a) ? x : m[i] |})
  {
    unfold arr(a, m);
    var i := 0;
    while (i < length(a))
      invariant 0 <= i && i <= length(a)
      invariant forall j: Int :: {loc(a, j)} 0 <= j && j < i ==> own(a[j], x)
      invariant forall j: Int :: {loc(a, j)} i <= j && j < length(a) ==> own(a[j], m[j])
    {
      a[i] := x;
      i := i + 1;
    }
    fold arr(a, {| i: Int :: 0 <= i && i < length(a) ? x : m[i] |});
  }

  proc read_ghost(a: A.T, implicit ghost v: Int) returns (ghost r: Int)
    requires 0 < length(a) && own(a[0], v, 0.5)
    ensures own(a[0], v, 0.5) && r == v
  {
    r := a[0];
  }
}
