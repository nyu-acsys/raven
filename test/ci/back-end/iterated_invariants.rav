// Quantified invariant instances need no injective index: instances are persistent and
// agree on their implicit parameters, so no distinctness of the tagged objects
// is stated.

interface Cells {
  func loc(i: Int) returns (r: Ref)
  func index(r: Ref) returns (i: Int)

  auto lemma loc_injective()
    ensures forall i: Int :: {loc(i)} index(loc(i)) == i
}

module Make[C: Cells] {
  field label: (Ref, Int)
  field slot: Ref

  inv tag(x: Ref; implicit ghost k: (Ref, Int)) { own(x.label, k, 0.5) }

  proc make(c: Ref, n: Int) returns (xs: Map[Int, Ref])
    requires 0 <= n
    requires forall j: Int :: 0 <= j && j < n ==> (exists v: Ref :: own(C.loc(j).slot, v))
    ensures (forall j: Int :: 0 <= j && j < n ==> own(C.loc(j).slot, xs[j]) && tag(xs[j], (c, j)))
  {
    var i: Int := 0;
    while (i < n)
      invariant 0 <= i && i <= n
      invariant forall j: Int :: i <= j && j < n ==> (exists v: Ref :: own(C.loc(j).slot, v))
      invariant (forall j: Int :: 0 <= j && j < i ==> own(C.loc(j).slot, xs[j]) && tag(xs[j], (c, j)))
    {
      var x: Ref;
      x := new(label: (c, i));
      fold tag(x, (c, i));
      C.loc(i).slot := x;
      xs := xs[i := x];
      i := i + 1;
    }
  }
}
