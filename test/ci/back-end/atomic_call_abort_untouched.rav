// On abort, the caller's resources are restored from those it held where it opened
// cInv. Here x.d is given up and regained in between, while x.e is never touched.

field c: Int
field d: Int
field e: Int

inv cInv(x: Ref) { exists n: Int :: own(x.c, n, 1.0) }

free proc incr(x: Ref, implicit ghost n: Int)
  atomic requires own(x.c, n, 1.0)
  atomic ensures own(x.c, n + 1, 1.0)

proc restores(x: Ref)
  requires cInv(x) && own(x.d, 0, 1.0) && own(x.e, 0, 1.0)
{
  unfold cInv(x);
  exhale own(x.d, 0, 1.0);
  inhale own(x.d, 0, 1.0);
  incr(x);
  fold cInv(x);
}
