interface Family {
  inv root(x: Int)
  inv leaf(x: Int) within root(x)

  lemma step(x: Int)
    requires leaf(x)
    ensures leaf(x)
    opens leaf(x)
}

interface Inherited : Family {
  inv leaf(owner: Int)
}

module Client[P: Inherited] {
  lemma use(x: Int)
    requires P.leaf(x)
    ensures P.leaf(x)
    opens P.root(x)
  {
    P.step(x);
  }
}

module Actual : Inherited {
  inv root(x: Int) { true }
  inv leaf(x: Int) parent root(x) { true }

  lemma step(x: Int) {
    unfold leaf(x);
    fold leaf(x);
  }
}

module Use = Client[Actual]
