inv root(x: Int) { child(x, 0) }
inv child(x: Int, k: Int) parent root(x) { true }
inv marker(x: Int) parent root(x) { true }
proc allocate(x: Int)
  ensures marker(x)
  opens {}
{ fold marker(x); }
proc bad(x: Int)
  requires marker(x)
  opens {}
{
  spawn allocate(x);
  unfold marker(x);
  fold marker(x);
}
