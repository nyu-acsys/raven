import Library.IntAtomics._

module Actual {
  field value: Int

  proc increment(x: Ref, implicit ghost n: Int) returns (r: Int)
    atomic requires own(x.value, n, 1.0)
    atomic ensures own(x.value, n + 1, 1.0) && r == n
  {
    ghost val token := bindAU();
    n := openAU(token);
    r := faa(x.value, 1);
    commitAU(token, r);
  }
}

interface Counter {
  field value: Int
  proc increment(x: Ref, implicit ghost n: Int) returns (r: Int)
    atomic requires own(x.value, n, 1.0)
    atomic ensures own(x.value, n + 1, 1.0) && r <= n
}

module View : Counter = checked Actual

inv shared(x: Ref) { exists n: Int :: own(x.Actual.value, n, 1.0) }

proc client(x: Ref)
  requires shared(x)
{
  unfold shared(x);
  val result := View.increment(x);
  fold shared(x);
}
