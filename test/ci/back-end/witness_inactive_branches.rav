field f: Int

type State = data {
  case idle(value: Int);
  case busy(code: Int)
}

free pred ticket(token: Int)

pred state(x: Ref, s: State) {
  s is idle ? own(x.f, s.value) :
    (exists token: Int :: ticket(token))
}

lemma inactive_predicate_branch(x: Ref)
  requires own(x.f, 7)
  ensures state(x, idle(7))
{
  fold state(x, idle(7));
}

lemma matching_selector(x: Ref)
  requires own(x.f, 7)
{
  exhale idle(7).value == 7 ? own(x.f, 7) :
    (exists token: Int :: ticket(token));
}

lemma tuple_guard(x: Ref)
  requires own(x.f, 7)
{
  exhale (false, true)#1 ? own(x.f, 7) :
    (exists token: Int :: ticket(token));
}

lemma boolean_guards(x: Ref)
  requires own(x.f, 7)
{
  exhale (!(idle(7) is busy) && (idle(7) is busy || true) &&
    (idle(7) is busy ==> false)) ?
    own(x.f, 7) : (exists token: Int :: ticket(token));
}

lemma constructor_equality(x: Ref)
  requires own(x.f, 7)
{
  exhale idle(7) == busy(7) ? (exists token: Int :: ticket(token)) :
    (!(idle(7) == idle(8)) ? own(x.f, 7) :
      (exists token: Int :: ticket(token)));
}

lemma quantified_guard(x: Ref)
  requires own(x.f, 7)
{
  exhale (forall n: Int :: idle(n) is idle) ? own(x.f, 7) :
    (exists token: Int :: ticket(token));
}
