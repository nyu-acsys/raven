module Box[E: Library.Type] {
  rep type T = data { case box(value: E) }
}

interface BoxSpec[E: Library.Type] {
  func get(b: Box[E]) returns (r: E)
    ensures r == b.value
  func make(v: E) returns (r: Box[E])
    ensures r.value == v
}

module Boxes[E: Library.Type] :> BoxSpec[E] {
  func get(b: Box[E]) returns (r: E) { b.value }
  func make(v: E) returns (r: Box[E]) { Box.box(v) }
}

interface PairSpec[A: Library.Type, B: Library.Type] {
  func choose(a: A, b: Box[B]) returns (r: B)
    ensures r == b.value
}

module Pairs[X: Library.Type, Y: Library.Type] :> PairSpec[Y, X] {
  func choose(a: Y, b: Box[X]) returns (r: X) { b.value }
}

module Generic[E: Library.Type] {
  lemma conversions(xs: Library.List[E], value: E) {
    val b: Box[E] := Boxes.make(value);
    assert Boxes.get(b) == value;
    assert Library.Seq.length(Library.Seq.of_list(xs)) == Library.List.len(xs);
  }
}

lemma concrete() {
  val b: Box[Int] := Boxes.make(4);
  assert Boxes.get(b) == 4;
  assert Pairs.choose(false, b) == 4;
  val xs: Library.List[Int] := Library.List.::(3, Library.List.::(7, Library.List.nil));
  val s: Library.Seq[Int] := Library.Seq.of_list(xs);
  assert Library.Seq.length(s) == 2;
  assert Library.Seq.index(s, 0) == 3;
  assert Library.Seq.index(s, 1) == 7;

  val xss: Library.List[Library.List[Int]] := Library.List.::(xs, Library.List.nil);
  assert Library.Seq.length(Library.Seq.of_list(xss)) == 1;
  assert Library.Seq.index(Library.Seq.of_list(xss), 0) == xs;
}

module Imported {
  import Library.Seq.of_list
  lemma convert(xs: Library.List[Ref]) {
    assert Library.Seq.length(of_list(xs)) == Library.List.len(xs);
  }
}
