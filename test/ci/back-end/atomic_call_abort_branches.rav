// Logically atomic calls with ordinary preconditions in branches, each opening the
// invariant within its branch, and an implicit argument of the ordinary precondition
// bound where the invariant is opened.

field c: Int
field d: Int

inv cInv(x: Ref) { exists n: Int :: own(x.c, n, 1.0) }

free proc incr(x: Ref, y: Ref, implicit ghost m: Int, implicit ghost n: Int)
  requires own(y.d, m, 1.0)
  ensures own(y.d, m, 1.0)
  atomic requires own(x.c, n, 1.0)
  atomic ensures own(x.c, n + 1, 1.0)

proc caller(x: Ref, y: Ref, z: Ref, b: Bool)
  requires cInv(x) && own(y.d, 0, 1.0) && own(z.d, 1, 1.0)
  ensures own(y.d, 0, 1.0) && own(z.d, 1, 1.0)
{
  if (b) {
    unfold cInv(x);
    incr(x, y);
    fold cInv(x);
  } else {
    unfold cInv(x);
    incr(x, z);
    fold cInv(x);
  }
}

// The frame restored on abort holds y.d, which the call keeps.
proc keeps(x: Ref, y: Ref)
  requires cInv(x) && own(y.d, 0, 1.0)
  ensures own(y.d, 0, 1.0)
{
  unfold cInv(x);
  incr(x, y);
  fold cInv(x);
}
