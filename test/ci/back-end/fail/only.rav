proc p(x: Int) returns (y: Int)
  requires x > 0
  ensures y > 0
{
  assert positive: x > 0;
  assert wrong: x > 5;
  var i: Int := 0;
  while (i < 3)
    invariant i >= 0
  {
    assert in_loop: i >= 0;
    assert loop_wrong: i >= 1;
    i := i + 1;
  }
  y := x;
}

module M {
  lemma fine(x: Int)
    ensures x + 0 == x
  {}

  lemma bad(x: Int)
    ensures x + 1 == x
  {}
}

proc count(n: Int) returns (i: Int)
  requires n >= 0
  ensures i == n
{
  i := 0;
  while (i < n)
    invariant bounded: 0 <= i <= n
    invariant wrong_entry: i >= 1
    invariant wrong_step: i <= 1
  {
    i := i + 1;
  }
}
