// The call and its abort check share the exhale of p's ordinary precondition, some
// fraction of x.d, which can be all of it: dInv, which needs half of x.d, may not be
// closable if the call aborts.

import Library.IntAtomics._

field d: Int
field c: Int

inv dInv(x: Ref) {
  exists n: Int :: own(x.c, n, 1.0) && own(x.d, 0, 0.5)
}

proc p(x: Ref, implicit ghost n: Int)
  requires exists q: Real :: q > 0.0 && own(x.d, 0, q)
  atomic requires own(x.c, n, 1.0)
  atomic ensures own(x.c, n + 1, 1.0)
{
  ghost var phi := bindAU();
  ghost var n0: Int := openAU(phi);
  var old_val: Int := faa(x.c, 1);
  commitAU(phi, ());
}

proc writer(x: Ref)
  requires dInv(x) && own(x.d, 0, 0.5)
{
  unfold dInv(x);
  p(x);
  fold dInv(x);
}
