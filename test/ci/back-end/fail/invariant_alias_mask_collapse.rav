interface Regions {
  inv first(x: Int)
  inv second(x: Int)
}

inv cell(x: Int) { true }

module Actual : Regions {
  inv first(x: Int) = cell
  inv second(x: Int) = cell
}

module Worker[P: Regions] {
  lemma open_both(ghost x: Int)
    requires P.first(x) && P.second(x)
  {
    unfold P.first(x);
    unfold P.second(x);
    fold P.second(x);
    fold P.first(x);
  }
}

module Applied = Worker[Actual]
