// Two logically atomic calls in different branches cannot both give up their ordinary
// preconditions where the same invariant was opened: open it within each branch.

field c: Int
field d: Int

inv cInv(x: Ref) { exists n: Int :: own(x.c, n, 1.0) }

free proc incr(x: Ref, y: Ref, implicit ghost n: Int)
  requires own(y.d, 0, 1.0)
  ensures own(y.d, 0, 1.0)
  atomic requires own(x.c, n, 1.0)
  atomic ensures own(x.c, n + 1, 1.0)

proc caller(x: Ref, y: Ref, z: Ref, b: Bool)
  requires cInv(x) && own(y.d, 0, 1.0) && own(z.d, 0, 1.0)
{
  unfold cInv(x);
  if (b) {
    incr(x, y);
  } else {
    incr(x, z);
  }
  fold cInv(x);
}
