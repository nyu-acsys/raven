field value: Int
inv cell(c: Ref) { own(c.value, 0) }

proc logical(c: Ref, implicit ghost before: Int) returns (ghost result: Int)
  atomic requires own(c.value, before)
  atomic ensures own(c.value, before) && result == before
{
  ghost val token := bindAU()
  atomic {
    ghost val previous: Int := openAU(token)
    result := previous
    commitAU(token, result)
  }
}

atomic proc physical(c: Ref) returns (ghost result: Int)
  requires own(c.value, 0)
  ensures own(c.value, 0) && result == 0
{
  c.value := 1
  c.value := 0
  result := 0
}

proc caller_logical(c: Ref)
  requires cell(c)
{
  unfold cell(c)
  ghost val first := logical(c)
  ghost val second := logical(c)
  fold cell(c)
}

proc caller_physical(c: Ref)
  requires cell(c)
{
  unfold cell(c)
  ghost val first := physical(c)
  ghost val second := physical(c)
  fold cell(c)
}
