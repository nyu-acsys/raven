// Implementations cannot widen an inherited mask through opaque resource bodies.

field f: Int

interface M1 {
  inv i(x: Ref)

  proc helper(x: Ref)
    requires i(x)
    atomic requires own(x.f, 1)
    atomic ensures false
}

interface M2 {
  inv test(x: Ref) {
    own(x.f, 1)
  }
}

module N : M1, M2 {
  inv i(x: Ref) {
    test(x)
  }

  proc helper(x: Ref)
    requires i(x)
    atomic requires own(x.f, 1)
    atomic ensures false
  {
    ghost val phi := bindAU;
    openAU(phi)
    unfold i(x)
    unfold test(x)
    x.f := 1
    assert false
    fold test(x)
    fold i(x)
    commitAU(phi, ())
  }
}

module Client {
  proc exploit(x: Ref)
    requires N.i(x) && N.test(x)
    atomic requires true
  {
    ghost var phi := bindAU
    openAU(phi)
    unfold N.test(x)
    N.helper(x)
    fold N.test(x)
    commitAU(phi, ())
  }
}
