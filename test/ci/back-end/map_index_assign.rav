// `m[k] := v` assigns `m[k := v]` to the local map variable `m`, also when nested.
proc update(m: Map[Int, Int], mm: Map[Int, Map[Int, Int]])
  returns (n: Map[Int, Int], nn: Map[Int, Map[Int, Int]])
  ensures n == m[0 := 1] && nn == mm[1 := mm[1][2 := 3]]
{
  n := m;
  n[0] := 1;
  nn := mm;
  nn[1][2] := 3;
}

proc read(m: Map[Int, Int]) returns (v: Int)
  ensures v == m[3]
{
  v := m[3];
}
