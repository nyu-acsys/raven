// A ghost update before a logically atomic call that keeps the open invariant
// closable: the ghost counter is independent of the physical one, so the state on
// abort still satisfies the invariant.

import Library.Auth
import Library.MaxNat
import Library.IntAtomics._

module AuthMaxNat = Auth[MaxNat]
import AuthMaxNat._

field count: Int
ghost field g: AuthMaxNat

inv counterInv(x: Ref) {
  exists n: Int, m: Int :: own(x.count, n, 1.0) && own(x.g, auth_frag(m, m))
}

proc incr(x: Ref, implicit ghost n: Int)
  atomic requires own(x.count, n, 1.0)
  atomic ensures own(x.count, n + 1, 1.0)
{
  ghost var phi := bindAU();
  ghost var n0: Int := openAU(phi);
  var old_val: Int := faa(x.count, 1);
  commitAU(phi, ());
}

proc writer(x: Ref)
  requires counterInv(x)
{
  unfold counterInv(x);
  ghost var m: Int;
  m :| own(x.g, auth_frag(m, m));
  fpu(x.g, auth_frag(m, m), auth_frag(m + 1, m + 1));
  incr(x);
  fold counterInv(x);
}
