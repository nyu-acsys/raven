module Box[E: Library.Type] {
  rep type T = data { case box(value: E) }
}
module Left[E: Library.Type] {
  func get(b: Box[E]) returns (r: E) { b.value }
}
module Right[E: Library.Type] {
  func get(b: Box[E]) returns (r: E) { b.value }
}
import Left.get
import Right.get
lemma check(b: Box[Int]) {
  assert get(b) == 1;
}
