// Members that are not in the interface of a sealed functor are not accessible
// through its implicit instances either.

interface Stack[E: Library.Type] : Library.Type {
  rep type T
  val empty: T
  func push(s: T, e: E) returns (ret: T)
  func size(s: T) returns (ret: Int)

  auto lemma size_empty()
    ensures size(empty) == 0
}

module ListStack[E: Library.Type] :> Stack[E] {
  rep type T = data { case nil case cons(hd: E, tl: T) }
  val empty: T = nil
  func push(s: T, e: E) returns (ret: T) { cons(e, s) }
  func size(s: T) returns (ret: Int)
    decreases s
  { s == nil ? 0 : 1 + size(s.tl) }

  lemma size_push(s: T, e: E)
    ensures size(push(s, e)) == size(s) + 1
  {}
}

module Client {
  lemma uses_constructor(s: ListStack[Int])
  {
    var t := ListStack.cons(1, s);
  }
}
