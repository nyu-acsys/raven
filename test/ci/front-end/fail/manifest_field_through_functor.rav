// KNOWN LIMITATION, and the case manifest fields are ultimately for: handing a
// client's own field to a functor.
//
// The per-field artifacts (the Frac and FieldUtils modules) are named after the
// field and live beside it. A functor's contract mentioning H.f carries the type
// H.Frac$f.T, and instantiating substitutes H -> Adapt syntactically, so
// Adapt.Frac$f has to exist. A manifest field deliberately does not get its own
// -- it must share the target's, or the two would disagree about the resource
// algebra over one heap -- and making the shared one reachable under both names
// requires paths to two names for the same module to denote the same type. That
// is the module-identity limitation recorded in
// test/ci/front-end/fail/diamond_modules.rav.
//
// The failure below is therefore expected, though the message is poor: it names
// an internal generated module rather than explaining any of the above. When
// module identity is addressed this test should start passing and move out of
// fail/.

interface HasField {
  module E : Library.Type
  field f : E
}

module Uses[H: HasField] {
  proc get(x: Ref, ghost w: H.E) returns (v: H.E)
    requires own(x.H.f, w, 1.0)
    ensures  own(x.H.f, w, 1.0) && v == w
  { v := x.H.f; }
}

module IntT : Library.Type { rep type T = Int }

module Client {
  field count: Int

  module Adapt : HasField {
    module E = IntT
    field f = Client.count
  }

  module U = Uses[Adapt]

  proc use(x: Ref, ghost w: Int) returns (v: Int)
    requires own(x.count, w, 1.0)
    ensures  own(x.count, w, 1.0) && v == w
  { v := U.get(x, w); }
}
