// No call determines a formal constrained by an interface with neither a rep type nor a
// single field, so a use of the functor's member asks for an explicit instantiation.

interface K {
  func foo() returns (res: Int)
}

module P[X: K] {
  func id(n: Int) returns (res: Int) { n }
}

proc p() {
  var x := P.id(3);
}
