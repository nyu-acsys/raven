// The standard library's atomic primitives are each built on an `atomic { ... }`
// block, so a program that merely *calls* one -- this file -- risks picking up
// warnings about code it did not write. It doesn't: the standard library is
// loaded with every concrete proc's body stripped before type-checking even
// begins (the library is trusted, not reverified per program), so the embedded
// `cas`'s `atomic` block never exists as far as this analysis is concerned.
// There is nothing to warn about, not merely something suppressed.
//
// Compare atomic_block.rav, where the block is the user's own and is flagged.
// Checking lib/library/atomics.rav *directly as a program* (rather than
// importing it) sidesteps the free-marking above entirely -- its bodies are
// then intact and its blocks are warned about under `--strict` like any other
// input; see lib/library/library.t.

import Library.Atomics._

field flag: Bool

inv held(x: Ref) { exists b: Bool :: own(x.flag, b, 1.0) }

proc take(x: Ref) returns (got: Bool)
  requires held(x)
{
  unfold held(x);
  got := cas(x.flag, false, true);
  fold held(x);
}
