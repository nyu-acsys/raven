// Exercise 2 solution: gcd by repeated subtraction (subtractive Euclid), which
// avoids `mod` so the loop invariant stays simple linear arithmetic.
//
// We deliberately don't specify that `r` is *the greatest* common divisor here
// (proving that needs some nonlinear divisibility reasoning that's more than
// this exercise is about) -- just that the loop terminates at a single shared,
// positive value no larger than either input, which is the part a loop
// invariant is actually responsible for.
proc gcd(a: Int, b: Int) returns (r: Int)
  requires a > 0 && b > 0
  ensures r > 0 && r <= a && r <= b
{
  var x := a
  var y := b
  while (x != y)
    invariant x > 0 && y > 0
    invariant x <= a && y <= b
  {
    if (x > y) {
      x := x - y
    } else {
      y := y - x
    }
  }
  r := x
}
