// This file is DELIBERATELY BROKEN -- it will not type-check, on purpose.
//
// `mkTag` takes no argument at all, so nothing at the call site pins down
// what `T` should be. Expect:
//
//   [Error] Type Error: Cannot infer a type argument for parameter T of Box;
//   write an explicit instantiation, e.g. `module M_X = Box[...]`
//
// The call below has neither argument types nor an expected result type
// from which to infer `T`. An annotation such as `Box[Int]` supplies that
// missing context. Alternatively, follow the diagnostic: instantiate
// `Box` explicitly under a name and call its member through that module.
// The appendix's `inference.rav` checks the successful annotated forms.
module Box[T: Library.Type] {
  rep type S = data {
    case box(unwrap: T)
    case tag(flag: Bool)
  }

  func mkTag() returns (res: S) {
    tag(true)
  }
}

proc demo() {
  var n := Box.mkTag()
}
