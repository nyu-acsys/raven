field value: Int
free val root: Ref

inv cell(x: Ref) { own(x.value, 0, 1.0) }

interface Resource {
  inv shared(x: Ref)
  lemma touch(x: Ref) requires shared(x) ensures shared(x)
}

module Actual : Resource {
  inv shared(x: Ref) { cell(root) }
  lemma touch(x: Ref) {
    unfold shared(x);
    unfold cell(root);
    fold cell(root);
    fold shared(x);
  }
}
