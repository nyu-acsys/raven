module Tokens() {
  type T = data { case token(value: Int) }
}
module First = Tokens()
module Second = Tokens()
module Alias = First

proc demo() {
  val first: First.T := First.token(3);
  val same: Alias.T := first;
  assert same.value == 3;
  val second: Second.T := Second.token(5);
  assert second.value == 5;
}

module Helpers() {
  type T = Int
  val one: T = 1
  func increment(x: T) returns (r: T) { x + one }
}
module UsesHelpers[E: Library.Type] {
  module H = Helpers()
  func increment(x: Int) returns (r: Int) { H.increment(x) }
}
module UsesInt = UsesHelpers[Int]
lemma increment() ensures UsesInt.increment(3) == 4 { }
