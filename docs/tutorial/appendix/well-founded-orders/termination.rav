// Lexicographic descent: the inner call decreases n with m fixed;
// the outer call decreases m, regardless of the inner call's result.
func ackermann(m: Int, n: Int) returns (r: Int)
  decreases m, n
{
  m <= 0 ?
    n + 1 :
    (n <= 0 ? ackermann(m - 1, 1) : ackermann(m - 1, ackermann(m, n - 1)))
}
